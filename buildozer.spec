[app]
title = Sistema
package.name = sistema
package.domain = org.sistema
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,kivy,plyer,pyjnius,android
orientation = portrait
fullscreen = 0
